# Copy to .env and fill in real values (never commit .env).
# Local Postgres — or the dev Supabase project's direct connection.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pizzeria_dev
# Dev Supabase project; FastAPI derives the JWT issuer and JWKS URL from it.
SUPABASE_URL=https://<project-ref>.supabase.co
